# VMusic Backend Environment Configuration
PROJECT_NAME="VMusic API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
CORS_ORIGINS=["*"]

# Security
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_GLOBAL="100/minute"
